# Application
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-string
APP_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite+aiosqlite:///./data/viralshorts.db
REDIS_URL=redis://localhost:6379/0
TIMEZONE=Asia/Kolkata
DAILY_PUBLISH_TARGET=24
PUBLISH_SLOTS=09:00,14:00,20:00
PUBLISH_TIME_1=09:00
PUBLISH_TIME_2=14:00
PUBLISH_TIME_3=20:00
QUALITY_THRESHOLD=70
DEFAULT_LANGUAGE=en
YOUTUBE_CATEGORY_ID=24
PUBLISHING_MODE=automatic
APPROVAL_REQUIRED=false
AUTOMATION_PAUSED=false
WORKER_ENABLED=true
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# Rendering limits for small instances: x264 allocates per-thread frame buffers.
FFMPEG_THREADS=1
RENDER_MEMORY_BUDGET_MB=420

# Local storage (do not use ephemeral Render disk for production videos)
MEDIA_ROOT=./data/media
RENDER_ROOT=./data/renders
OBJECT_STORAGE_URL=
OBJECT_STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Dashboard login (change immediately)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Telegram remote control + notices. Never commit the real token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_IDS=
TELEGRAM_NOTIFICATIONS=true

# Optional free-tier media APIs (app works without them)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Hacker AI — official OpenAI-compatible API. Docs: https://hackerai.sh/how-to-use-api
# An inference key starts with sk-. An hsb_ token belongs to `npx @hackerai/local`
# (the bridge that connects a machine to HackerAI) and cannot generate scripts.
HACKERAI_API_KEY=
HACKERAI_API_BASE_URL=https://api.hackerai.sh/v1
HACKERAI_MODEL=auto

# Optional local/remote AI fallbacks
OLLAMA_BASE_URL=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ElevenLabs — set here or paste in Configuration Center. Never commit the real key.
# On boot the app Fernet-encrypts this into the database using APP_SECRET_KEY.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STS_MODEL_ID=eleven_multilingual_sts_v2
DEFAULT_VOICE=Rachel
VOICE_LANGUAGE=en
VOICE_STABILITY=0.5
VOICE_SIMILARITY=0.75

# YouTube OAuth (official Google Cloud credentials only)
# After deploy, paste Client ID/Secret on Integrations and click Connect YouTube.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/youtube/callback
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly https://www.googleapis.com/auth/yt-analytics.readonly
