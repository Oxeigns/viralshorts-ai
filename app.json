{
  "name": "viralshorts-ai",
  "description": "VIRALSHORTS AI — production YouTube Shorts factory",
  "repository": "https://github.com/Oxeigns/viralshorts-ai",
  "website": "https://github.com/Oxeigns/viralshorts-ai",
  "success_url": "/",
  "keywords": ["youtube", "shorts", "fastapi", "ffmpeg", "telegram"],
  "env": {
    "APP_ENV": {"description": "Application Environment", "required": true, "value": "production"},
    "APP_SECRET_KEY": {"description": "Fernet and session key. Generate a long random string.", "required": true, "generator": "secret"},
    "APP_BASE_URL": {"description": "Public backend URL for OAuth and Telegram webhooks", "required": true, "value": "https://your-app.onrender.com"},
    "FRONTEND_URL": {"description": "Public frontend URL", "required": false, "value": "https://your-app.onrender.com"},
    "ADMIN_USERNAME": {"description": "Dashboard username", "required": true, "value": "admin"},
    "ADMIN_PASSWORD": {"description": "Dashboard password — change immediately", "required": true},
    "DATABASE_URL": {"description": "PostgreSQL URL. Render injects this from viralshorts-db.", "required": false},
    "REDIS_URL": {"description": "Optional Redis/Celery broker", "required": false, "value": "redis://localhost:6379/0"},
    "HACKERAI_API_KEY": {"description": "Hacker AI key from https://hackerai.sh/pricing", "required": false},
    "HACKERAI_API_BASE_URL": {"description": "Official OpenAI-compatible base URL", "required": false, "value": "https://api.hackerai.sh/v1"},
    "HACKERAI_MODEL": {"description": "Hacker AI model id", "required": false, "value": "auto"},
    "ELEVENLABS_API_KEY": {"description": "ElevenLabs API key — encrypted at boot", "required": false},
    "ELEVENLABS_VOICE_ID": {"description": "ElevenLabs voice id", "required": false, "value": "21m00Tcm4TlvDq8ikWAM"},
    "DEFAULT_VOICE": {"description": "Friendly default voice name", "required": false, "value": "Rachel"},
    "VOICE_LANGUAGE": {"description": "en, hi, or hinglish", "required": false, "value": "en"},
    "VOICE_STABILITY": {"description": "ElevenLabs stability 0-1", "required": false, "value": "0.5"},
    "VOICE_SIMILARITY": {"description": "ElevenLabs similarity 0-1", "required": false, "value": "0.75"},
    "TELEGRAM_BOT_TOKEN": {"description": "Bot token from @BotFather", "required": false},
    "TELEGRAM_ADMIN_IDS": {"description": "Comma-separated numeric Telegram user ids", "required": false},
    "TELEGRAM_CHAT_ID": {"description": "Fallback chat id for notices", "required": false},
    "TELEGRAM_NOTIFICATIONS": {"description": "true or false", "required": false, "value": "true"},
    "GOOGLE_CLIENT_ID": {"description": "Google OAuth Web client id", "required": false},
    "GOOGLE_CLIENT_SECRET": {"description": "Google OAuth Web client secret", "required": false},
    "GOOGLE_REDIRECT_URI": {"description": "Must match {APP_BASE_URL}/api/integrations/youtube/callback", "required": false},
    "DAILY_PUBLISH_TARGET": {"description": "Daily upload limit", "required": true, "value": "3"},
    "PUBLISH_TIME_1": {"description": "Slot 1 HH:MM", "required": true, "value": "09:00"},
    "PUBLISH_TIME_2": {"description": "Slot 2 HH:MM", "required": true, "value": "14:00"},
    "PUBLISH_TIME_3": {"description": "Slot 3 HH:MM", "required": true, "value": "20:00"},
    "TIMEZONE": {"description": "IANA timezone", "required": true, "value": "Asia/Kolkata"},
    "DEFAULT_LANGUAGE": {"description": "Default script language", "required": true, "value": "en"},
    "YOUTUBE_CATEGORY_ID": {"description": "YouTube category id", "required": false, "value": "24"},
    "PUBLISHING_MODE": {"description": "automatic | approval | manual", "required": true, "value": "approval"},
    "APPROVAL_REQUIRED": {"description": "true or false", "required": false, "value": "true"},
    "OBJECT_STORAGE_URL": {"description": "S3-compatible endpoint", "required": false},
    "STORAGE_ACCESS_KEY": {"description": "Object storage access key", "required": false},
    "STORAGE_SECRET_KEY": {"description": "Object storage secret key", "required": false},
    "OBJECT_STORAGE_BUCKET": {"description": "Object storage bucket", "required": false},
    "WORKER_ENABLED": {"description": "true or false", "required": false, "value": "true"},
    "SCHEDULER_ENABLED": {"description": "true or false", "required": false, "value": "true"},
    "LOG_LEVEL": {"description": "DEBUG INFO WARNING ERROR", "required": false, "value": "INFO"}
  },
  "formation": {
    "web": {"quantity": 1},
    "worker": {"quantity": 1}
  },
  "addons": ["postgresql"],
  "note": "This file is a configuration schema with empty secret placeholders. Deploy with render.yaml, not by treating app.json as a Render Blueprint."
}
